{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/evidence-records.schema.json",
  "title": "Curated modern evidence records",
  "type": "object",
  "required": ["schema_version", "scope_note", "records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "scope_note": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "topicLink": {
      "type": "object",
      "required": ["id", "relevance"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "relevance": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "topics", "summary_zh", "conclusion_direction", "directness", "evidence_type",
        "confidence", "limitations_zh", "population_zh", "intervention_zh", "outcomes_zh",
        "source_registry_id", "source_title", "source_organization", "publication_date", "url",
        "doi", "pmid", "language", "verified_at", "expires_at", "source_content_sha256",
        "verification_method", "status"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "topics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/topicLink"}},
        "summary_zh": {"type": "string", "minLength": 10},
        "conclusion_direction": {"enum": ["supports", "mixed", "negative", "uncertain", "safety-warning", "emergency-action", "not-applicable"]},
        "directness": {"enum": ["direct", "indirect", "not-directly-comparable"]},
        "evidence_type": {"enum": ["official-guidance", "regulatory-information", "clinical-guideline", "systematic-review", "meta-analysis", "randomized-trial", "observational-study", "mechanistic-study", "official-evidence-summary"]},
        "confidence": {"enum": ["higher", "moderate", "limited", "very-limited", "no-direct-clinical-evidence"]},
        "limitations_zh": {"type": "string", "minLength": 5},
        "population_zh": {"type": "string"},
        "intervention_zh": {"type": "string"},
        "outcomes_zh": {"type": "string"},
        "source_registry_id": {"type": "string", "minLength": 1},
        "source_title": {"type": "string", "minLength": 1},
        "source_organization": {"type": "string", "minLength": 1},
        "publication_date": {"type": "string", "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$"},
        "url": {"type": "string", "pattern": "^https://"},
        "doi": {"type": "string"},
        "pmid": {"type": "string", "pattern": "^(?:|[0-9]+)$"},
        "language": {"type": "string", "minLength": 2},
        "verified_at": {"type": "string", "format": "date"},
        "expires_at": {"type": "string", "format": "date"},
        "source_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verification_method": {"enum": ["manual-full-page-review", "official-api-and-page-review"]},
        "status": {"enum": ["verified", "superseded", "retracted"]}
      }
    }
  }
}
