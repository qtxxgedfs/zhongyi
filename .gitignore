# These two reviewed read-only product databases are required for offline use.
!skill/tcm-classics-study/data/classics.sqlite
!skill/tcm-classics-study/data/evidence-cache.sqlite

# Generated corpus snapshots are governed by source-lock.json and may be large.
# Uncomment locally if raw snapshots are stored outside version control.
# sources/raw/

# Runtime-generated writable overlays; the curated read-only seed cache is tracked.
skill/tcm-classics-study/data/evidence-cache.runtime.sqlite*
skill/tcm-classics-study/data/*.sqlite-wal
skill/tcm-classics-study/data/*.sqlite-shm
skill/tcm-classics-study/data/package-candidate-manifest.json

